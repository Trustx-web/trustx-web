# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Transactional Email Delivery (Server-Side Only — Never expose to frontend)
# Option 1: Resend API (recommended for cloud serverless/containers)
RESEND_API_KEY=""
EMAIL_FROM="TrustX Inquiries <inquiries@trustx.world>"

# Option 2: Standard SMTP (e.g. Microsoft 365, Azure Communication Services, SendGrid, Postmark, Google Workspace)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Option 3: FormSubmit (default when Resend/SMTP are unset; uses CONTACT_RECIPIENT_EMAIL)
# Optionally set FORMSUBMIT_ENDPOINT to your hashed FormSubmit token URL (e.g. https://formsubmit.co/ajax/<token>)
FORMSUBMIT_ENDPOINT=""

# Recipient address for TrustX contact & demo inquiries
CONTACT_RECIPIENT_EMAIL="krishnakamireddy@trustx.world"
